# Secure Dice private configuration template
#
# This file is documentation only. Never add real passwords or secrets to this
# copy, commit a completed configuration, or place the completed file inside
# the public website directory.
#
# DreamHost Shared Hosting setup:
#   1. Replace YOUR_DREAMHOST_USER and the example addresses below.
#   2. Generate SECUREDICE_SECRET once. It authenticates stored results and
#      protects recipient data, so back it up with the database:
#        /usr/local/php84/bin/php -r 'echo bin2hex(random_bytes(32)), PHP_EOL;'
#   3. Copy this file outside the website and make it private:
#        cp .securedice.env.example /home/YOUR_DREAMHOST_USER/.securedice.env
#        chmod 600 /home/YOUR_DREAMHOST_USER/.securedice.env
#   4. Create the private data directory if needed:
#        mkdir -p /home/YOUR_DREAMHOST_USER/securedice-data
#        chmod 700 /home/YOUR_DREAMHOST_USER/securedice-data
#   5. Create securedice@rpglibrary.org in DreamHost's Manage Email page and
#      put its mailbox password below.
#   6. Run the worker every minute with DreamHost cron, using locking:
#        /usr/local/php84/bin/php /home/YOUR_DREAMHOST_USER/rpglibrary.org/software/securedice/bin/process-email-queue.php --limit=100 --quiet
#
# Secure Dice automatically reads /home/<user>/.securedice.env. To use another
# location, define SECUREDICE_CONFIG_PATH in both the web and CLI environments.
# Existing process environment variables override values in this file.
# Blank lines and lines beginning with # are ignored. Quote values containing
# leading/trailing spaces. Double-quoted values support \\, \", \n, \r, and \t.

SECUREDICE_DB_PATH="/home/YOUR_DREAMHOST_USER/securedice-data/securedice.sqlite"
SECUREDICE_SECRET="REPLACE_WITH_64_HEXADECIMAL_CHARACTERS"
SECUREDICE_BASE_URL="https://www.rpglibrary.org/software/securedice"

SECUREDICE_SMTP_HOST="smtp.dreamhost.com"
SECUREDICE_SMTP_PORT="587"
SECUREDICE_SMTP_ENCRYPTION="starttls"
SECUREDICE_SMTP_USERNAME="securedice@rpglibrary.org"
SECUREDICE_SMTP_PASSWORD="REPLACE_WITH_DREAMHOST_MAILBOX_PASSWORD"
SECUREDICE_SMTP_FROM_ADDRESS="securedice@rpglibrary.org"
SECUREDICE_SMTP_FROM_NAME="Secure Dice"
SECUREDICE_SMTP_TIMEOUT="15"
